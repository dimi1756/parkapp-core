# Copy this file to ".env" and fill in your real Mapbox token.
# Get a free token at https://account.mapbox.com/access-tokens/
# Without this token, the app automatically falls back to the static demo map.
VITE_MAPBOX_TOKEN=pk.your_mapbox_token_here

# Supabase project credentials (Project Settings -> API in the Supabase dashboard).
# The anon key is safe to expose client-side; RLS policies (see supabase/migrations)
# are what actually restrict access. Never put the service_role key in this file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
